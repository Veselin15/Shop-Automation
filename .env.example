# --- BestSecret ---
# Само за информация/автоматичен re-login опит. Първият вход се прави РЪЧНО
# (shopbot login bestsecret) и сесията се пази в profiles/bestsecret.
BESTSECRET_EMAIL=
BESTSECRET_PASSWORD=

# --- Bazar.bg ---
BAZAR_EMAIL=
BAZAR_PASSWORD=

# --- Известия (по избор, но силно препоръчано) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Оценка на артикулите от модел (appraisal в config.yaml) ---
# Ключ от console.anthropic.com. Без него appraisal.enabled: true спира
# всички обяви (on_error: skip) — или сложи ключа, или изключи оценката.
ANTHROPIC_API_KEY=

# --- Runtime ---
SHOPBOT_HEADLESS=1
SHOPBOT_DATA_DIR=./data
